def first_nonreapeating(text):
    frequency = {}
    for ch in text:
        if ch in frequency:
            frequency[ch] += 1
        else:
            frequency[ch] = 1
    for ch in frequency:
        if frequency[ch] == 1:
            return ch
text = "aabbcde"
result = first_nonreapeating(text)
print(result)
